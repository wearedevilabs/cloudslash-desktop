# RevenueCat configuration for the CloudSlash desktop app.
#
# Copy to `.env.local` (gitignored) and fill in the publishable key. Do NOT commit
# `.env.local`, and never put a secret key here — see the note at the bottom.
#
#   cp .env.example .env.local
#
# The Web Billing publishable key, prefixed `rcb_`. Found in the RevenueCat
# dashboard under Project settings, for the Web Billing app.
VITE_REVENUECAT_WEB_API_KEY=

# The entitlement that unlocks the Pro artifacts. Must match the identifier
# configured on the entitlement in RevenueCat.
VITE_REVENUECAT_ENTITLEMENT_ID=cloudslash_pro

# Optional. Leave empty to use whichever offering is marked "current" in
# RevenueCat. Set it to pin the app to a specific offering (e.g. a promo).
VITE_REVENUECAT_OFFERING_ID=

# Optional ISO 4217 code to force a currency for price display.
VITE_REVENUECAT_CURRENCY=

# Optional. A hosted checkout used when the SDK cannot take the payment: no key
# configured, or a webview that will not run the checkout. A RevenueCat Web
# Purchase Link or a Stripe Payment Link both work here, and this path needs no
# key at all.
VITE_SUPPORT_URL=

# ---------------------------------------------------------------------------
# About the secret key
#
# RevenueCat's secret key (prefixed `sk_`) is deliberately NOT accepted anywhere
# in this application, in any variable, at any time. It grants full control of
# the RevenueCat project. Putting one in a desktop build hands it to everyone who
# installs the app, and the app bundle is trivial to unpack.
#
# The build refuses a secret key rather than shipping it: see
# src/config/revenuecat.ts, which rejects an `sk_` value and surfaces the reason
# in the Account screen.
#
# Keep `REVENUECAT_SECRET_KEY` in your shell or CI secret store for server-side
# tasks only (revenue reporting, subscriber lookups from a backend). It is never
# read by this project.
# ---------------------------------------------------------------------------
